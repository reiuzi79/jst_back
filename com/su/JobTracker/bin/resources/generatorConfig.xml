<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE generatorConfiguration PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
    "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">

<generatorConfiguration>
    <context id="MySQLTables" targetRuntime="MyBatis3">
        <jdbcConnection driverClass="com.mysql.cj.jdbc.Driver"
                        connectionURL="jdbc:mysql://localhost:3306/jobapplicationtracker?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC"
                        userId="test"
                        password="qwe123456"/>

        <javaModelGenerator targetPackage="com.su.JobTracker.model" targetProject="src/main/java"/>
        <sqlMapGenerator targetPackage="mappers" targetProject="src/main/resources"/>
        <javaClientGenerator type="XMLMAPPER" targetPackage="com.su.JobTracker.mapper" targetProject="src/main/java"/>

        <table tableName="registered_users" domainObjectName="user" />
        <table tableName="user_companies" domainObjectName="userCompany" />
        <table tableName="saved_jobs" domainObjectName="savedJob" />
        <table tableName="reviews" domainObjectName="review" />
        <table tableName="messages" domainObjectName="message" />
        <table tableName="job_postings" domainObjectName="jobPosting" />
        <table tableName="job_applications" domainObjectName="jobApplication" />
        <table tableName="companies" domainObjectName="company" />
        <table tableName="application_status_history" domainObjectName="applicationStatusHistory" />
    </context>
</generatorConfiguration>